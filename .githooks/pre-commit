#!/usr/bin/env sh
# Project pre-commit hook.
# Enabled via `git config core.hooksPath .githooks` (done automatically by the
# package.json "prepare" script on `npm install`).
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
fail=0

# 1. Junk, size and image-width checks. CI runs the same script on the files a
#    push or PR changes, so the hook is a convenience, not the enforcement.
node scripts/validate-images.js --staged || fail=1

# 2. Syntax-check staged JS (no dependencies required). Split on newlines only,
#    so a path with spaces stays one item.
IFS='
'
for f in $staged; do
  case "$f" in
    *.js | *.mjs | *.cjs)
      [ -f "$f" ] || continue
      node --check "$f" || fail=1
      ;;
  esac
done
unset IFS

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: aborting commit (use 'git commit --no-verify' to bypass)"
  exit 1
fi

# 3. Format staged code with Prettier via lint-staged.
if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged
else
  echo "› lint-staged not installed; skipping formatting (run 'npm install')"
fi

# 4. Validate front-matter across all posts (~0.2s).
npm run --silent validate

# 5. Flag opacity modifiers on brand colors outside the design system's
#    alpha-eligible set.
npm run --silent validate-brand-alpha
