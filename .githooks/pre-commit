#!/usr/bin/env sh
# Project pre-commit hook.
# Enabled via `git config core.hooksPath .githooks` (done automatically by the
# package.json "prepare" script on `npm install`).
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
fail=0

# 1. Block accidental junk: .DS_Store and files larger than 5MB.
for f in $staged; do
  case "$f" in
    *.DS_Store | .DS_Store)
      echo "✖ refusing to commit $f"
      fail=1
      ;;
  esac
done
for f in $staged; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt 5242880 ]; then
    echo "✖ $f is over 5MB ($((size / 1048576))MB) — reconsider or use git-lfs"
    fail=1
  fi
done

# 2. Syntax-check staged JS (no dependencies required).
for f in $staged; do
  case "$f" in
    *.js | *.mjs | *.cjs)
      [ -f "$f" ] || continue
      node --check "$f" || fail=1
      ;;
  esac
done

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: aborting commit (use 'git commit --no-verify' to bypass)"
  exit 1
fi

# 3. Format staged code with Prettier via lint-staged.
if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged
else
  echo "› lint-staged not installed; skipping formatting (run 'npm install')"
fi

# 4. Validate front-matter across all posts (~0.2s).
npm run --silent validate
