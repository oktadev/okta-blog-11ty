{
  "name": "okta-blog-11ty",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "css": "tailwindcss -i ./public/css/index.css -o ./_site/style.css --minify",
    "css:watch": "tailwindcss -i ./public/css/index.css -o ./_site/style.css --watch",
    "validate": "node scripts/validate-frontmatter.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "npm run build && npm run smoke",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "setup": "mkdir -p _site/img && ([ -d _site/fonts ] || cp -r public/fonts _site/) && ([ -d _site/js ] || cp -r public/js _site/) && ([ -d _site/img/avatar ] || cp -r public/img/avatar _site/img/)",
    "start": "ELEVENTY_ENV=development npm run css && npm run setup && ELEVENTY_ENV=development eleventy --serve --incremental",
    "build": "ELEVENTY_ENV=production npm run css && npm run setup && ELEVENTY_ENV=production eleventy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.1",
    "@11ty/eleventy-plugin-rss": "^2.0.3",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/eleventy-plugin-vite": "^6.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/vite": "^4.1.3",
    "eleventy-plugin-asciidoc": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.5.0",
    "luxon": "^3.6.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-table-of-contents": "^0.9.0",
    "prettier": "^3.4.2",
    "prismjs": "^1.30.0",
    "tailwindcss": "^4.1.3"
  },
  "dependencies": {
    "eleventy-plugin-embed-twitter": "^1.4.3"
  }
}
