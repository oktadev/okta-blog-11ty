{
  "name": "@oktadev/okta-blog-11ty",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i ./public/css/index.css -o ./_site/blog/style.css --minify",
    "validate": "node scripts/validate-frontmatter.js",
    "validate-images": "node scripts/validate-images.js",
    "lint-content": "node scripts/lint-content.js",
    "validate-brand-alpha": "node scripts/validate-brand-alpha.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "npm run test:unit && npm run build && npm run smoke",
    "test:unit": "node --test test/*.test.js",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "setup": "mkdir -p _site/blog/img && npm run css && ([ -d _site/blog/fonts ] || cp -r public/fonts _site/blog/) && ([ -d _site/blog/js ] || cp -r public/js _site/blog/) && ([ -d _site/blog/img/avatar ] || cp -r public/img/avatar _site/blog/img/) && cp public/img/*.svg _site/blog/img/ && node scripts/copy-raw-assets.js",
    "start": "ELEVENTY_ENV=development npm run setup && ELEVENTY_ENV=development eleventy --serve --incremental",
    "build": "ELEVENTY_ENV=production npm run setup && ELEVENTY_ENV=production eleventy",
    "post": "node scripts/post.js",
    "dev": "DEV_POSTS=25 npm start"
  },
  "keywords": [],
  "author": "Okta Builder Advocacy <dev-advocacy@okta.com>",
  "license": "Apache-2.0",
  "description": "The Okta Developer Blog",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "eleventy-plugin-embed-twitter": "^1.4.4",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^5.2.1",
    "lint-staged": "^17.0.8",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "prettier": "^3.9.4",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "fsevents@2.3.3": true
  }
}
