{
  "name": "okta-blog-11ty",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "css": "tailwindcss -i ./public/css/index.css -o ./_site/style.css --minify",
    "validate": "node scripts/validate-frontmatter.js",
    "validate-images": "node scripts/validate-images.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "npm run test:unit && npm run build && npm run smoke",
    "test:unit": "node --test test/*.test.js",
    "migrate": "node scripts/migrate-posts.js",
    "verify-migration": "node scripts/verify-migration.js",
    "sync-code-blocks": "node scripts/sync-code-blocks.js",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "setup": "npm run css && mkdir -p _site/img && ([ -d _site/fonts ] || cp -r public/fonts _site/) && ([ -d _site/js ] || cp -r public/js _site/) && ([ -d _site/img/avatar ] || cp -r public/img/avatar _site/img/) && cp public/img/*.svg _site/img/",
    "start": "ELEVENTY_ENV=development npm run setup && ELEVENTY_ENV=development eleventy --serve --incremental",
    "build": "ELEVENTY_ENV=production npm run setup && ELEVENTY_ENV=production eleventy",
    "post": "node scripts/post.js",
    "dev": "DEV_POSTS=25 npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "eleventy-plugin-embed-twitter": "^1.4.4",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^5.2.1",
    "lint-staged": "^17.0.8",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "prettier": "^3.9.4",
    "prismjs": "^1.30.0",
    "tailwindcss": "^4.3.2"
  },
  "dependencies": {
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0"
  }
}
