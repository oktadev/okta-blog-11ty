---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:media="http://search.yahoo.com/mrss/"
     xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title }}</title>
    <link>{{ site.baseUrl }}</link>
    <description>{{ site.description }}</description>
    <language>{{ site.lang }}</language>
    <atom:link href="{{ site.baseUrl }}/feed.xml" rel="self" type="application/rss+xml" />
    {% if collections.posts %}
    <lastBuildDate>{{ collections.posts | getNewestCollectionItemDate | dateToRfc822 }}</lastBuildDate>
    {% endif %}
    {#- Only the most recent posts: every item carries its full content, so the
        whole archive would make the feed tens of megabytes. -#}
    {%- for post in collections.posts | reverse | limit(20) %}
    {% set absolutePostUrl %}{{ site.baseUrl }}{{ post.url | url }}{% endset %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ absolutePostUrl }}</link>
      <guid isPermaLink="true">{{ absolutePostUrl }}</guid>
      <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
      {%- if post.data.description %}
      <description>{{ post.data.description }}</description>
      {%- endif %}
      {%- if post.data.image %}
      <media:thumbnail url="{{ site.baseUrl }}/img/blog/{{ post.data.image }}" />
      {%- endif %}
      <content:encoded>{{ post.templateContent | htmlToAbsoluteUrls(absolutePostUrl) | cdata | safe }}</content:encoded>
    </item>
    {%- endfor %}
  </channel>
</rss>
