{% set blogSections = [
  { url: "/blog/tags/", title: "All Tags" },
  { url: "/blog/authors/", title: "All Authors" }
] %}
<nav class="border-b border-okta-gravel bg-okta-white" aria-label="Blog sections">
  <ul class="flex items-center gap-6 min-h-11 px-6 lg:px-16 list-none m-0">
    {% for section in blogSections %}
    <li>
      <a href="{{ section.url | url }}" class="text-okta-blue no-underline"{% if page.url == section.url %} aria-current="page"{% endif %}>{{ section.title }}</a>
    </li>
    {% endfor %}
  </ul>
</nav>
