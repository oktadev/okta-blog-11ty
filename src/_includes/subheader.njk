{% set blogSections = [
  { url: "/blog/tags/", title: "All Tags" },
  { url: "/blog/authors/", title: "All Authors" }
] %}
<nav class="border-b border-page-border bg-brand-utility-grey-100" aria-label="Blog sections">
  <ul class="flex items-center gap-6 min-h-11 px-6 lg:px-16 list-none m-0">
    {% for section in blogSections %}
    <li>
      <a href="{{ section.url | url }}" class="text-brand-primary-blue-400 no-underline hover:underline"{% if page.url == section.url %} aria-current="page"{% endif %}>{{ section.title }}</a>
    </li>
    {% endfor %}
  </ul>
</nav>
