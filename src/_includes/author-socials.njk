    <a href="{{ author.twitter }}" class="{{ iconBtn }}" aria-label="{{ author.full_name }} on X" title="X Profile" rel="me noopener noreferrer" target="_blank">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7071 4.70711C21.0976 4.31658 21.0976 3.68342 20.7071 3.29289C20.3166 2.90237 19.6834 2.90237 19.2929 3.29289L13.348 9.23779L9.07342 3.40865C8.88504 3.15177 8.58555 3 8.267 3H4C3.62317 3 3.27833 3.21184 3.108 3.54798C2.93766 3.88412 2.97075 4.28747 3.19359 4.59135L9.45539 13.1304L3.2929 19.2929C2.90237 19.6834 2.90237 20.3166 3.2929 20.7071C3.68342 21.0976 4.31659 21.0976 4.70711 20.7071L10.652 14.7622L14.9266 20.5914C15.115 20.8482 15.4145 21 15.733 21H20C20.3768 21 20.7217 20.7882 20.892 20.452C21.0623 20.1159 21.0293 19.7125 20.8064 19.4086L14.5446 10.8696L20.7071 4.70711ZM12.3703 11.2866C12.4012 11.338 12.4371 11.3872 12.4781 11.4336L18.0266 19H16.2398L5.97338 5H7.76026L12.3703 11.2866Z"/></svg>
    </a>
  {% endif %}
  {# Website / external-link icon is always last #}
  {% if author.web %}
    <a href="{{ author.web }}" class="{{ iconBtn }}" aria-label="{{ author.full_name }}'s website" title="Website" rel="me noopener noreferrer" target="_blank">
      {% include "icons/external-link.svg" %}
    </a>
  {% endif %}
</div>
