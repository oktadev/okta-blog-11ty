<meta name="description" content="{{ description | default(page.description | default('')) }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.baseUrl }}/feed.xml">

<link rel="canonical" href="{{ page.url | toAbsoluteUrl }}" />
<meta property="og:type" content="article" />
<meta property="og:url" content="{{ page.url | toAbsoluteUrl }}" />
<meta property="og:title" content="{{ title }}" />
{% if description %}
  <meta property="og:description" content="{{ description }}" />
{% endif %}
{% if image %}
  {%- set ogImage = image | socialImage %}
  {% if ogImage %}<meta property="og:image" content="{{ ogImage | toAbsoluteUrl }}" />{% endif %}
{% endif %}
<meta property="og:site_name" content="{{ site.title }}" />

{# X/Twitter card. Twitter falls back to the og:* tags for title/description/image,
   so only the card type and attribution are needed. Credit the post author when
   we have their handle, else the site account. #}
{% set postAuthors = authors | authorFilter(author) %}
{% set twitterCreator = postAuthors[0].twitter | twitterHandle if postAuthors | length else "" %}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="{{ site.twitter }}" />
<meta name="twitter:creator" content="{{ twitterCreator or site.twitter }}" />
