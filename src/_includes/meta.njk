{% if site.isPreview %}<meta name="robots" content="noindex" />{% endif %}
<meta name="description" content="{{ description | default(page.description | default('')) }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.baseUrl }}/feed.xml">

{# Syndicated posts set `canonical` in front matter pointing at the original
   publication, so search engines credit that copy rather than this one. #}
<link rel="canonical" href="{{ canonical if canonical else (page.url | toAbsoluteUrl) }}" />
<meta property="og:type" content="article" />
<meta property="og:url" content="{{ page.url | toAbsoluteUrl }}" />
<meta property="og:title" content="{{ title }}" />
{% if description %}
  <meta property="og:description" content="{{ description }}" />
{% endif %}
{% if image %}
  {%- set ogImage = image | socialImage %}
  {% if ogImage %}<meta property="og:image" content="{{ ogImage | toAbsoluteUrl }}" />{% endif %}
{% endif %}
<meta property="og:site_name" content="{{ site.title }}" />

{# Twitter falls back to the og:* tags for title/description/image, so only the
   card type and attribution are needed here. #}
{% set postAuthors = authors | authorFilter(author) %}
{% set twitterCreator = postAuthors[0].twitter | twitterHandle if postAuthors | length else "" %}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="{{ site.twitter }}" />
<meta name="twitter:creator" content="{{ twitterCreator or site.twitter }}" />
