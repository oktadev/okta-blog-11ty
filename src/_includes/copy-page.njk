{#
  "Copy page" split button for posts: copies the post as Markdown, with a menu
  to view that Markdown or open it in an AI assistant. The Markdown is built by
  src/post-markdown.11ty.js at the post's URL with ".md" in place of the
  trailing slash.
#}
{% set markdownUrl = page.url | replace(r/\/$/, "") + ".md" %}
{% set markdownAbsolute = markdownUrl | toAbsoluteUrl %}
{% set aiPrompt = "Read " + markdownAbsolute + " so I can ask questions about it." %}
<div class="copy-page relative inline-flex shrink-0 text-sm md:mt-3" data-markdown-url="{{ markdownUrl }}">
  <div class="inline-flex rounded-sm border border-page-border bg-white">
    <button type="button" data-copy-page class="inline-flex items-center gap-2 px-3 py-1.5 text-content-text hover:bg-brand-utility-grey-100 rounded-l-sm focus-visible:outline-2 focus-visible:outline-links focus-visible:z-10 [&_svg]:size-4">
      <span data-copy-icon class="inline-flex">{% include "icons/copy.svg" %}</span>
      <span data-copied-icon class="hidden">{% include "icons/check.svg" %}</span>
      <span data-copy-label>Copy page</span>
    </button>
    <button type="button" id="copy-page-menu-button" class="inline-flex items-center px-2 border-l border-page-border text-content-text hover:bg-brand-utility-grey-100 rounded-r-sm focus-visible:outline-2 focus-visible:outline-links focus-visible:z-10" aria-expanded="false" aria-controls="copy-page-menu" aria-haspopup="menu" aria-label="More options for this page">
      <span data-copy-chevron class="inline-flex transition-transform duration-200 [&_svg]:size-4">{% include "icons/chevron-down.svg" %}</span>
    </button>
  </div>
  <ul id="copy-page-menu" class="absolute left-0 md:left-auto md:right-0 top-full mt-2 hidden w-80 max-w-[calc(100vw-3rem)] rounded-sm border border-page-border bg-white p-2 shadow-md z-50" role="menu" aria-labelledby="copy-page-menu-button">
    <li role="none">
      <button type="button" data-copy-page role="menuitem" tabindex="-1" class="w-full text-left flex gap-3 rounded-sm p-3 hover:bg-brand-utility-grey-100 focus-visible:bg-brand-utility-grey-100 focus-visible:outline-2 focus-visible:outline-links [&_svg]:size-5 [&_svg]:mt-0.5 [&_svg]:shrink-0">
        {% include "icons/copy.svg" %}
        <span><span class="block text-content-text-strong">Copy page</span><span class="block text-sm text-brand-primary-neutral-400">Copy page as Markdown for LLMs</span></span>
      </button>
    </li>
    <li role="none">
      <a href="{{ markdownUrl }}" target="_blank" rel="noopener" role="menuitem" tabindex="-1" class="flex gap-3 rounded-sm p-3 hover:bg-brand-utility-grey-100 focus-visible:bg-brand-utility-grey-100 focus-visible:outline-2 focus-visible:outline-links [&_svg]:size-5 [&_svg]:mt-0.5 [&_svg]:shrink-0">
        {% include "icons/markdown.svg" %}
        <span><span class="block text-content-text-strong">View as Markdown</span><span class="block text-sm text-brand-primary-neutral-400">Open this page as plain text</span></span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    </li>
    <li role="none">
      <a href="https://claude.ai/new?q={{ aiPrompt | urlencode }}" target="_blank" rel="noopener noreferrer" role="menuitem" tabindex="-1" class="flex gap-3 rounded-sm p-3 hover:bg-brand-utility-grey-100 focus-visible:bg-brand-utility-grey-100 focus-visible:outline-2 focus-visible:outline-links [&_svg]:size-5 [&_svg]:mt-0.5 [&_svg]:shrink-0">
        {% include "icons/chat.svg" %}
        <span><span class="block text-content-text-strong">Open in Claude</span><span class="block text-sm text-brand-primary-neutral-400">Ask questions about this page</span></span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    </li>
    <li role="none">
      <a href="https://chatgpt.com/?hints=search&q={{ aiPrompt | urlencode }}" target="_blank" rel="noopener noreferrer" role="menuitem" tabindex="-1" class="flex gap-3 rounded-sm p-3 hover:bg-brand-utility-grey-100 focus-visible:bg-brand-utility-grey-100 focus-visible:outline-2 focus-visible:outline-links [&_svg]:size-5 [&_svg]:mt-0.5 [&_svg]:shrink-0">
        {% include "icons/chat.svg" %}
        <span><span class="block text-content-text-strong">Open in ChatGPT</span><span class="block text-sm text-brand-primary-neutral-400">Ask questions about this page</span></span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    </li>
  </ul>
  <span data-copy-status class="sr-only" role="status" aria-live="polite"></span>
</div>

{% js %}
(function () {
  var root = document.querySelector(".copy-page");
  if (!root) return;

  var url = root.getAttribute("data-markdown-url");
  var button = document.getElementById("copy-page-menu-button");
  var menu = document.getElementById("copy-page-menu");
  var items = Array.prototype.slice.call(menu.querySelectorAll('[role="menuitem"]'));
  var chevron = root.querySelector("[data-copy-chevron]");
  var label = root.querySelector("[data-copy-label]");
  var status = root.querySelector("[data-copy-status]");
  var copyIcon = root.querySelector("[data-copy-icon]");
  var copiedIcon = root.querySelector("[data-copied-icon]");
  var markdown;
  var resetTimer;

  // Fetched once and reused, so a second copy needs no network.
  function load() {
    if (!markdown) {
      markdown = fetch(url).then(function (response) {
        if (!response.ok) throw new Error("HTTP " + response.status);
        return response.text();
      });
      markdown.catch(function () { markdown = null; });
    }
    return markdown;
  }

  function showResult(text) {
    label.textContent = text;
    // Announced once; the label reverting to "Copy page" is not news.
    if (text !== "Copy page") status.textContent = text === "Copied" ? "Page copied as Markdown" : text;
    copyIcon.classList.toggle("hidden", text === "Copied");
    copiedIcon.classList.toggle("hidden", text !== "Copied");
    clearTimeout(resetTimer);
    resetTimer = setTimeout(function () {
      showResult("Copy page");
      status.textContent = "";
    }, 2000);
  }

  // Safari and Firefox only allow a clipboard write started inside the click
  // handler, so hand them a ClipboardItem wrapping the pending fetch rather
  // than awaiting it. Firefox before 127 has no ClipboardItem and falls back to
  // writeText after the fetch, which it permits as long as the page has focus.
  function copy() {
    var write;
    if (window.ClipboardItem && navigator.clipboard && navigator.clipboard.write) {
      var blob = load().then(function (text) {
        return new Blob([text], { type: "text/plain" });
      });
      write = navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })]);
    } else if (navigator.clipboard && navigator.clipboard.writeText) {
      write = load().then(function (text) { return navigator.clipboard.writeText(text); });
    } else {
      write = Promise.reject(new Error("Clipboard unavailable"));
    }
    write.then(
      function () { showResult("Copied"); },
      function () { showResult("Copy failed"); }
    );
  }

  function isOpen() {
    return button.getAttribute("aria-expanded") === "true";
  }

  function setOpen(open) {
    menu.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
    if (chevron) chevron.classList.toggle("rotate-180", open);
  }

  function focusItem(index) {
    var count = items.length;
    items[((index % count) + count) % count].focus();
  }

  function close(returnFocus) {
    if (!isOpen()) return;
    setOpen(false);
    if (returnFocus) button.focus();
  }

  root.querySelectorAll("[data-copy-page]").forEach(function (el) {
    el.addEventListener("click", function () {
      copy();
      // The menu's own Copy item was focused; put focus back on the trigger
      // rather than letting it fall to <body> when the menu hides.
      close(menu.contains(el));
    });
  });

  // Links open a new tab; close behind them.
  items.forEach(function (item) {
    if (item.tagName === "A") item.addEventListener("click", function () { close(false); });
  });

  // Warm the cache when the reader shows intent, so the copy is instant.
  root.addEventListener("pointerenter", load, { once: true });
  root.addEventListener("focusin", load, { once: true });

  button.addEventListener("click", function () {
    setOpen(!isOpen());
  });

  // Arrow keys on the trigger open the menu on the first or last item.
  button.addEventListener("keydown", function (event) {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      setOpen(true);
      focusItem(event.key === "ArrowDown" ? 0 : -1);
    }
  });

  menu.addEventListener("keydown", function (event) {
    var index = items.indexOf(document.activeElement);
    if (event.key === "ArrowDown") focusItem(index + 1);
    else if (event.key === "ArrowUp") focusItem(index - 1);
    else if (event.key === "Home") focusItem(0);
    else if (event.key === "End") focusItem(-1);
    else if (event.key === "Tab") return close(false);
    else return;
    event.preventDefault();
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && isOpen()) close(true);
  });

  document.addEventListener("click", function (event) {
    if (isOpen() && !root.contains(event.target)) close(false);
  });
  document.addEventListener("focusin", function (event) {
    if (isOpen() && !root.contains(event.target)) close(false);
  });
})();
{% endjs %}
