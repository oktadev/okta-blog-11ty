<div class="py-2 px-5 mb-6 rounded-sm bg-green-50 text-okta-sky border-1 border-okta-slate" role="alert">
  <p class="text-green-800 text-lg mb-3 font-bold">
    <a class="float-right text-sm cursor-pointer" aria-label="Close" title="Close" onclick="this.parentElement.parentElement.style.display='none'">
      <span aria-hidden="true">&times;</span>
    </a>
    Heads up... this blog post is old!
  </p>
  {% set post = collections.posts | postBySlug(updated.slug) %}
  {% if post %}
    <p class="text-green-800">For an updated version of this blog post, {% if post.data.title %}see <a class="font-bold" href="{{ post.url | toAbsoluteUrl }}">{{ post.data.title }}</a>.{% else %}<a class="font-bold" href="{{ post.url | toAbsoluteUrl }}">click here</a>.{% endif %}</p>
  {% endif %}
    {% if updated.extra %}
      <p class="text-green-800">{{ updated.extra }}</p>
    {% endif %}
</div>
