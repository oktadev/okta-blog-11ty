<div class="py-2 px-5 mb-6 rounded-sm bg-brand-notifications-900 border border-brand-notifications-1000" role="alert">
  <div class="flex w-full items-start justify-between gap-3 mb-3 border-2">
    <p class="text-brand-utility-grey-900 text-lg font-semibold">Heads up... this post is old!</p>
    <button type="button" class="border shrink-0 -m-1.5 p-1.5 text-brand-utility-grey-900" aria-label="Close" title="Close" onclick="this.closest('[role=alert]').style.display='none'">
      {% include "icons/close.svg" %}
    </button>
  </div>
  {% set post = collections.posts | postBySlug(updated.slug) %}
  {% if post %}
    <p class="text-brand-utility-grey-900">For an updated version of this post, {% if post.data.title %}see <a href="{{ post.url | toAbsoluteUrl }}">{{ post.data.title }}</a>.{% else %}<a href="{{ post.url | toAbsoluteUrl }}">click here</a>.{% endif %}</p>
  {% endif %}
    {% if updated.extra %}
      <p class="text-brand-utility-grey-900">{{ updated.extra }}</p>
    {% endif %}
</div>
