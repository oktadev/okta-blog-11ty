<footer class="bg-okta-dark-blue text-okta-white antialiased py-12">
  <div class="w-full max-w-8xl px-6 lg:px-12 2xl:px-0 space-y-12 mx-auto">

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-y-12 [&_a]:text-okta-white [&_h4]:font-okta">
      <div class="space-y-6 sm:col-span-2 md:col-span-3 lg:col-span-1">
        <a class="footer-logotype" href="/">
          {% svg {src:"logotype", alt:"Okta developer logotype", type:"logo", widths:[180]} %}
        </a>
        <div class="mt-3">
          <h4 class="text-xl font-medium font-okta">Questions?</h4>
          <p>
            Ask us on the
            <a href="https://devforum.okta.com/" target="_blank" rel="noopener noreferrer" class="underline">forum</a>.
          </p>
        </div>

        <div class="space-y-1">
          <h4 class="text-lg font-medium font-okta">Connect with us</h4>
          <ul class="flex flex-row list-none gap-3 [&_a]:text-okta-white">
            <li><a href="https://github.com/oktadev" target="_blank" rel="noopener noreferrer" aria-label="Okta on GitHub">{% include "icons/github.svg" %}</a></li>
            <li><a href="https://twitter.com/OktaDev" target="_blank" rel="noopener noreferrer" aria-label="Okta on X">{% include "icons/x.svg" %}</a></li>
            <li><a href="https://www.youtube.com/oktadev" target="_blank" rel="noopener noreferrer" aria-label="Okta on YouTube">{% include "icons/youtube.svg" %}</a></li>
            <li><a href="https://devforum.okta.com/" target="_blank" rel="noopener noreferrer" aria-label="Okta developer forum">{% include "icons/forum.svg" %}</a></li>
            <li><a href="{{ site.baseUrl }}/feed.xml" target="_blank" rel="noopener noreferrer" aria-label="Blog RSS feed">{% include "icons/rss.svg" %}</a></li>
          </ul>
        </div>
      </div>

      <div class="">
        <h4 class="text-okta-cream text-lg font-medium mb-1">Contact &amp; Legal</h4>
        <ul class="list-none">
          <li><a href="https://www.okta.com/contact/" target="_blank" rel="noopener noreferrer">Contact our team</a></li>
          <li><a href="https://www.okta.com/contact-sales/" target="_blank" rel="noopener noreferrer">Contact sales</a></li>
          <li><a href="https://developer.okta.com/terms/" target="_blank" rel="noopener noreferrer">Integrator Free Plan terms</a></li>
          <li><a href="https://www.okta.com/terms-of-service/" target="_blank" rel="noopener noreferrer">Site terms</a></li>
          <li><a href="https://www.okta.com/privacy-policy/" target="_blank" rel="noopener noreferrer">Privacy policy</a></li>
          <li><a href="https://developer.okta.com/copyright/" target="_blank" rel="noopener noreferrer">Copyright &amp; trademarks</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-okta-cream text-lg font-medium mb-1">More info</h4>
        <ul class="list-none">
          <li><a href="https://developer.okta.com/pricing/">Pricing</a></li>
          <li><a href="https://developer.okta.com/okta-integration-network/" target="_blank" rel="noopener noreferrer">Integrate with Okta</a></li>
          <li><a href="https://developer.okta.com/docs/change-log/">Change Log</a></li>
          <li><a href="https://developer.okta.com/3rd_party_notices/">3rd-party notes</a></li>
          <li><a href="https://developer.auth0.com/" target="_blank" rel="noopener noreferrer">Auth0</a></li>
        </ul>
      </div>

      <div class="space-y-3">
        <div>
          <a class="external-link" href="https://www.okta.com/" target="_blank" rel="noopener noreferrer">Okta.com</a>
          <p>Products, case studies, resources</p>
        </div>
        <div>
          <a class="external-link" href="https://help.okta.com/" target="_blank" rel="noopener noreferrer">Support center</a>
          <p>Knowledgebase, roadmaps, and more</p>
        </div>
        <div>
          <a class="external-link" href="https://trust.okta.com/" target="_blank" rel="noopener noreferrer">Trust</a>
          <p>System status, security, compliance</p>
        </div>
      </div>
    </div>

    <div class="space-y-2">
      <hr class="opacity-50 border-okta-white">
      <span>Copyright &copy; {{ site.year }} Okta. All rights reserved.</span>
    </div>
  </div>
</footer>
