{%- set fLink = "text-white/80 hover:text-white hover:underline transition-colors" -%}
{%- set fHead = "text-xs font-bold uppercase tracking-wider text-white/50 mb-3" -%}
{%- set fIcon = "inline-flex text-white/70 hover:text-white transition-colors" -%}

<footer class="bg-okta-dark-blue text-white">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:flex-wrap md:justify-between">

      {# Need Support? #}
      <div class="md:max-w-xs">
        <h3 class="text-lg font-bold mb-2">Need Support?</h3>
        <p class="text-sm leading-relaxed text-white/80">
          You can reach us directly at
          <a href="mailto:developers@okta.com" class="{{ fLink }} underline">developers@okta.com</a>
          or you can also ask us on the
          <a href="https://devforum.okta.com/" target="_blank" rel="noopener noreferrer" class="{{ fLink }} underline">forum</a>.
        </p>
      </div>

      {# Social #}
      <nav aria-label="Social">
        <h4 class="{{ fHead }}">Social</h4>
        <ul class="flex gap-4 list-none p-0 m-0">
          <li>
            <a href="http://github.com/oktadev" target="_blank" rel="noopener noreferrer" class="{{ fIcon }}" aria-label="Okta on GitHub">
              {% include "icons/github.svg" %}
            </a>
          </li>
          <li>
            <a href="http://twitter.com/OktaDev" target="_blank" rel="noopener noreferrer" class="{{ fIcon }}" aria-label="Okta on X">
              {% include "icons/twitter.svg" %}
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/oktadev" target="_blank" rel="noopener noreferrer" class="{{ fIcon }}" aria-label="Okta on YouTube">
              {% include "icons/youtube.svg" %}
            </a>
          </li>
          <li>
            <a href="https://devforum.okta.com/" target="_blank" rel="noopener noreferrer" class="{{ fIcon }}" aria-label="Okta developer forum">
              {% include "icons/forum.svg" %}
            </a>
          </li>
          <li>
            <a href="https://developer.okta.com/feed.xml" target="_blank" rel="noopener noreferrer" class="{{ fIcon }}" aria-label="Blog RSS feed">
              {% include "icons/rss.svg" %}
            </a>
          </li>
        </ul>
      </nav>

      {# Contact & Legal #}
      <nav aria-label="Contact and legal">
        <h4 class="{{ fHead }}">Contact &amp; Legal</h4>
        <ul class="grid gap-2.5 list-none p-0 m-0 text-sm">
          <li><a class="{{ fLink }}" href="https://www.okta.com/contact/" target="_blank" rel="noopener noreferrer">Contact our team</a></li>
          <li><a class="{{ fLink }}" href="https://www.okta.com/contact-sales/" target="_blank" rel="noopener noreferrer">Contact sales</a></li>
          <li><a class="{{ fLink }}" href="https://developer.okta.com/terms/" target="_blank" rel="noopener noreferrer">Terms &amp; conditions</a></li>
          <li><a class="{{ fLink }}" href="https://www.okta.com/privacy-policy/" target="_blank" rel="noopener noreferrer">Privacy policy</a></li>
        </ul>
      </nav>

      {# More Info #}
      <nav aria-label="More info">
        <h4 class="{{ fHead }}">More Info</h4>
        <ul class="grid gap-2.5 list-none p-0 m-0 text-sm">
          <li><a class="{{ fLink }}" href="https://developer.okta.com/pricing/">Pricing</a></li>
          <li><a class="{{ fLink }}" href="https://developer.okta.com/okta-integration-network/" target="_blank" rel="noopener noreferrer">Integrate with Okta</a></li>
          <li><a class="{{ fLink }}" href="https://developer.okta.com/docs/change-log/">Change Log</a></li>
          <li><a class="{{ fLink }}" href="https://developer.okta.com/3rd_party_notices/">3rd-party notes</a></li>
          <li><a class="{{ fLink }}" href="https://auth0.com/developers/" target="_blank" rel="noopener noreferrer">Auth0 platform</a></li>
        </ul>
      </nav>

      {# External destinations #}
      <div class="grid gap-4 content-start">
        <a href="http://www.okta.com/" target="_blank" rel="noopener noreferrer" class="group block text-white no-underline">
          <span class="block font-bold tracking-wide group-hover:underline">OKTA.COM</span>
          <span class="block text-xs text-white/50">Products, case studies, resources</span>
        </a>
        <a href="http://help.okta.com/" target="_blank" rel="noopener noreferrer" class="group block text-white no-underline">
          <span class="block font-bold tracking-wide group-hover:underline">HELP CENTER</span>
          <span class="block text-xs text-white/50">Knowledgebase, roadmaps, and more</span>
        </a>
        <a href="http://trust.okta.com/" target="_blank" rel="noopener noreferrer" class="group block text-white no-underline">
          <span class="block font-bold tracking-wide group-hover:underline">TRUST</span>
          <span class="block text-xs text-white/50">System status, security, compliance</span>
        </a>
      </div>
    </div>

    {# Copyright #}
    <div class="mt-10 pt-6 border-t border-white/20 text-xs text-white/50">
      Copyright &copy; {{ site.year }} Okta.
    </div>
  </div>
</footer>
