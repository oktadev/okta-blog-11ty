<ul class="grid justify-center gap-1">
	{% for key, author in authorslist %}
		<li>
			<a href="{{ key }}/" class="inline-flex items-center gap-2">
				{% if author.avatar %}
          {% avatar author.avatar %}
        {% endif %}
				<p>{{ author.full_name }}</p>
			</a>
		</li>
	{% endfor %}
</ul>
