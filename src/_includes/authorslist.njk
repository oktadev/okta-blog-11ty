<ul class="grid justify-center gap-1">
	{% for key, author in authorslist|dictsort|sort(attribute='author.full_name') %}
		<li>
			<a href="/blog/authors/{{ key }}/" class="inline-flex items-center gap-2">
				{% if author.avatar %}
          {% avatar author.avatar, "small", author.full_name %}
        {% endif %}
				<p>{{ author.full_name }}</p>
			</a>
		</li>
	{% endfor %}
</ul>
