<nav>
  {# Nav Links stubbed in but should match current layout #}
  <ul class="nav__menu flex flex-row justify-around">
    {% for item in collections.all | eleventyNavigation %}
    {% if item.url %}
    {% set isCurrent = (item.url == page.url) %}
    {% set isParent = item.url != '/' and item.url in page.url %}
    <li class="nav__item{% if isCurrent or isParent %} nav__item--active{% endif %}">
      <a class="nav__link" href="{% if isCurrent %}#main{% else %}{{ item.url | url }}{% endif %}" {% if isCurrent %}
        aria-current="page" {% endif %}>
        {{ item.title }}
      </a>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</nav>
