<nav class="bg-okta-dark-blue">
  <div class="px-6 lg:px-16 min-h-16 xl:min-h-20 flex items-center gap-6 text-okta-white">

    <a class="shrink-0 mr-3 text-okta-white [&_svg]:w-40 [&_svg]:h-auto" href="https://developer.okta.com" aria-label="Okta Developer home">{% include "icons/logotype.svg" %}</a>

    {# Primary navigation — hidden below xl, moves into the mobile menu once it exists #}
    <div class="hidden xl:flex items-center gap-6">
      {# Coveo searchbox, wired by /js/search/index.js. Keep the .CoveoOmnibox and
         .CoveoAnalytics class names — Coveo finds them by class. Styles: public/css/coveo.css #}
      <div class="relative w-56 min-w-0 shrink 2xl:w-72" role="search" aria-label="Search Okta Developer content">
        {# Outside [data-search-bar], so Coveo can't overwrite it on init #}
        <span class="pointer-events-none absolute left-3 top-1/2 z-1 -translate-y-1/2 text-okta-white opacity-60">{% include "icons/search.svg" %}</span>
        <div data-search-bar data-pipeline="developer-okta-com">
          <div class="flex h-10 items-center rounded-sm bg-okta-white/10 focus-within:ring-2 focus-within:ring-okta-white/30 xl:h-11">
            <div class="CoveoOmnibox"></div>
          </div>
          <div class="CoveoAnalytics"></div>
        </div>
      </div>

      <div class="relative group">
        <button type="button" class="inline-flex items-center gap-1">
        Community
          <span class="inline-flex items-center relative top-0.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180">{% include "icons/chevron-down.svg" %}</span>
        </button>
        <div class="absolute right-0 top-8 hidden w-max rounded-sm bg-okta-white p-4 shadow-md group-hover:block group-focus-within:block z-51 before:absolute before:-top-2 before:left-0 before:right-0 before:h-2 before:content-['']">
          <div class="absolute -top-2 right-6 w-0 h-0 border-l-8 border-r-8 border-b-8 border-l-transparent border-r-transparent border-b-okta-white"></div>
          {% set forumUrl = "https://devforum.okta.com/" %}
          <a href="{{ forumUrl }}" class="block text-okta-carbon">Forum</a>
          <hr class="my-2 border-t border-okta-carbon/50"/>
          {% set socialChannels = [
            { url: "https://github.com/oktadev", label: "Okta Developers on GitHub", icon: "github.svg" },
            { url: "https://x.com/OktaDev", label: "Okta Developers on X", icon: "x.svg" },
            { url: "https://www.youtube.com/oktadev", label: "Okta Developers on YouTube", icon: "youtube.svg" }
          ] %}
          <ul class="flex gap-3" aria-label="Okta Developer social channels">
            {% for channel in socialChannels %}
            <li>
              <a href="{{ channel.url }}" class="block text-okta-carbon transition-transform hover:scale-110 focus-visible:scale-110" aria-label="{{ channel.label }}">{% include "icons/" + channel.icon %}</a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      {% set primaryNav = [
        { url: "/blog/", title: "Blog" },
        { url: "https://developer.okta.com/pricing/", title: "Pricing", external: true }
      ] %}
      <ul class="flex items-center gap-4">
        {% for item in primaryNav %}
        <li>
          <a class="inline-flex items-center gap-1 text-okta-white" href="{{ item.url | url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}{% if item.url == page.url %} aria-current="page"{% endif %}>
            {{ item.title }}{% if item.external %}<span class="inline-flex items-center opacity-80">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>{% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>

    {# Utility links and the Sign Up CTA collapse into the mobile menu #}
    <div class="ml-auto flex shrink-0 items-center gap-4">
      {% set utilityNav = [
        { url: "https://help.okta.com/", title: "Okta Docs" },
        { url: "https://okta.com/", title: "Okta" },
        { url: "https://login.okta.com/", title: "Sign in to Okta" }
      ] %}
      <ul class="hidden items-center gap-4 xl:flex">
        {% for item in utilityNav %}
        <li>
          <a class="inline-flex items-center gap-1 text-okta-white" href="{{ item.url }}" target="_blank" rel="noopener">
            {{ item.title }}<span class="inline-flex items-center opacity-80">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        {% endfor %}
      </ul>

      {% set signUpUrl = "https://developer.okta.com/signup/" %}
      <a class="hidden xl:inline-flex shrink-0 items-center whitespace-nowrap font-medium text-okta-white rounded border border-okta-white px-6 py-2" href="{{ signUpUrl }}">Sign Up</a>

      <button type="button" id="mobile-menu-button" class="xl:hidden inline-flex items-center" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span data-menu-icon="open">{% include "icons/menu.svg" %}</span>
        <span data-menu-icon="close" class="hidden">{% include "icons/close.svg" %}</span>
      </button>
    </div>
  </div>

  {# Mobile menu: the links that are hidden below xl. `relative z-52` puts it above
     the promo banner (z-50) and the desktop Community popup (z-51). Styling is
     deliberately minimal here; see #103. #}
  <div id="mobile-menu" class="hidden xl:hidden relative z-52 bg-okta-dark-blue px-6 pb-6 text-okta-white">
    <ul class="flex flex-col gap-4 py-4">
      {% for item in primaryNav %}
      <li>
        <a class="inline-flex items-center gap-1 text-okta-white" href="{{ item.url | url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}{% if item.url == page.url %} aria-current="page"{% endif %}>
          {{ item.title }}{% if item.external %}<span class="inline-flex items-center opacity-80">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>{% endif %}
        </a>
      </li>
      {% endfor %}
      {% for item in utilityNav %}
      <li>
        <a class="inline-flex items-center gap-1 text-okta-white" href="{{ item.url }}" target="_blank" rel="noopener">
          {{ item.title }}<span class="inline-flex items-center opacity-80">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
      {% endfor %}
      <li><a class="text-okta-white" href="{{ forumUrl }}">Forum</a></li>
      <li>
        <a class="inline-flex items-center gap-1 font-medium text-okta-white" href="{{ signUpUrl }}">
          Sign Up<span class="inline-flex items-center">{% include "icons/arrow-right.svg" %}</span>
        </a>
      </li>
    </ul>
    <ul class="flex gap-3" aria-label="Okta Developer social channels">
      {% for channel in socialChannels %}
      <li>
        <a href="{{ channel.url }}" class="block text-okta-white" aria-label="{{ channel.label }}">{% include "icons/" + channel.icon %}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</nav>

{% js %}
(function () {
  var button = document.getElementById("mobile-menu-button");
  var panel = document.getElementById("mobile-menu");
  if (!button || !panel) return;

  var openIcon = button.querySelector('[data-menu-icon="open"]');
  var closeIcon = button.querySelector('[data-menu-icon="close"]');
  // Matches Tailwind's `xl`, the width at which the desktop nav takes over.
  var desktop = window.matchMedia("(min-width: 80rem)");

  function isOpen() {
    return button.getAttribute("aria-expanded") === "true";
  }

  function setOpen(open) {
    panel.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (openIcon) openIcon.classList.toggle("hidden", open);
    if (closeIcon) closeIcon.classList.toggle("hidden", !open);
  }

  function close(returnFocus) {
    if (!isOpen()) return;
    setOpen(false);
    if (returnFocus) button.focus();
  }

  function isOutside(target) {
    return !panel.contains(target) && !button.contains(target);
  }

  button.addEventListener("click", function () {
    setOpen(!isOpen());
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") close(true);
  });

  // Pointer and keyboard both dismiss when attention moves out of the menu.
  document.addEventListener("click", function (event) {
    if (isOpen() && isOutside(event.target)) close(false);
  });
  document.addEventListener("focusin", function (event) {
    if (isOpen() && isOutside(event.target)) close(false);
  });

  // The desktop nav and an open panel must never both be on screen. Listen for
  // the breakpoint crossing and also check on resize, since a `change` event
  // isn't always delivered when the viewport is resized programmatically.
  function closeIfDesktop() {
    if (isOpen() && desktop.matches) close(false);
  }
  desktop.addEventListener("change", closeIfDesktop);
  window.addEventListener("resize", closeIfDesktop);
})();
{% endjs %}
