{% set forumUrl = "https://devforum.okta.com/" %}
{% set signUpUrl = "https://developer.okta.com/signup/" %}
{% set primaryNav = [
  { url: "/blog/", title: "Blog" },
  { url: "https://developer.okta.com/pricing/", title: "Pricing", external: true }
] %}
{% set utilityNav = [
  { url: "https://help.okta.com/", title: "Okta Docs" },
  { url: "https://okta.com/", title: "Okta" },
  { url: "https://login.okta.com/", title: "Sign in to Okta" }
] %}
{% set socialChannels = [
  { url: "https://github.com/oktadev", label: "Okta Developers on GitHub", icon: "github.svg" },
  { url: "https://x.com/OktaDev", label: "Okta Developers on X", icon: "x.svg" },
  { url: "https://www.youtube.com/oktadev", label: "Okta Developers on YouTube", icon: "youtube.svg" },
  { url: "https://www.linkedin.com/company/oktadev/", label: "Okta Developers on LinkedIn", icon: "linkedin.svg" }
] %}

{%- macro navLink(href, title, external, current) -%}
<a class="inline-flex items-center gap-1 text-links-contrast" href="{{ href }}"{% if external %} target="_blank" rel="noopener"{% endif %}{% if current %} aria-current="page"{% endif %}>{{ title }}{% if external %}<span class="inline-flex items-center opacity-80">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>{% endif %}</a>
{%- endmacro -%}

<nav class="bg-brand-primary-blue-500 text-page-text-contrast [&_a]:text-links-contrast" aria-label="Main">
  <div class="px-6 lg:px-16 min-h-16 md:min-h-20 flex flex-wrap items-center gap-x-6 gap-y-3 text-page-text-contrast">

    <a class="shrink-0 mr-3 [&_svg]:w-40 [&_svg]:h-auto" href="https://developer.okta.com" aria-label="Okta Developer home">{% include "icons/logotype.svg" %}</a>

    {# Coveo searchbox. Keep .CoveoOmnibox and .CoveoAnalytics — Coveo finds them by class; styles in public/css/coveo.css.
       Only one [data-search-bar] may exist: search/index.js mounts via querySelector, so a second copy renders an empty div. #}
    <div id="nav-search" class="hidden order-last w-full min-w-0 shrink relative mb-3 md:order-0 md:mb-0 md:flex md:w-56 2xl:w-72" role="search" aria-label="Search Okta Developer content">
      {# Outside [data-search-bar], so Coveo can't overwrite it on init #}
      <span class="pointer-events-none absolute left-3 top-1/2 z-1 -translate-y-1/2 opacity-60">{% include "icons/search.svg" %}</span>
      <div data-search-bar data-pipeline="developer-okta-com">
        <div class="flex h-10 items-center rounded-sm bg-brand-utility-grey-100/10 focus-within:ring-2 focus-within:ring-brand-utility-grey-100/30 lg:h-11">
          <div class="CoveoOmnibox"></div>
        </div>
        <div class="CoveoAnalytics"></div>
      </div>
    </div>

    <div class="hidden xl:flex items-center gap-6">
      <div class="relative [&_a]:text-page-text">
        <button type="button" id="community-menu-button" class="inline-flex items-center gap-1" aria-expanded="false" aria-controls="community-menu">
          Community
          <span data-community-chevron class="inline-flex items-center relative top-0.5 transition-transform duration-200">{% include "icons/chevron-down.svg" %}</span>
        </button>
        <div id="community-menu" class="absolute right-0 top-8 hidden w-max rounded-sm text-page-text bg-brand-utility-grey-100 p-4 shadow-md z-51">
          <div class="absolute -top-2 right-6 w-0 h-0 border-l-8 border-r-8 border-b-8 border-l-transparent border-r-transparent border-b-brand-utility-grey-100"></div>
          <a href="{{ forumUrl }}" class="block">Forum</a>
          <hr class="my-2 border-t border-page-border"/>
          <ul class="flex gap-3" aria-label="Okta Developer social channels">
            {% for channel in socialChannels %}
            <li>
              <a href="{{ channel.url }}" class="block transition-transform hover:scale-110 focus-visible:scale-110" aria-label="{{ channel.label }}">{% include "icons/" + channel.icon %}</a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <ul class="items-center gap-4 xl:flex">
        {% for item in primaryNav %}
        <li>{{ navLink(item.url | url, item.title, item.external, item.url == page.url) }}</li>
        {% endfor %}
      </ul>
    </div>

    {# Utility links and the Sign Up CTA collapse into the mobile menu #}
    <div class="ml-auto flex shrink-0 items-center gap-4">
      <ul class="hidden items-center gap-4 xl:flex">
        {% for item in utilityNav %}
        <li>{{ navLink(item.url, item.title, true, false) }}</li>
        {% endfor %}
      </ul>

      <a class="hidden md:inline-flex shrink-0 items-center whitespace-nowrap font-medium rounded border border-brand-utility-grey-100 px-6 py-2" href="{{ signUpUrl }}">Sign Up</a>

      <button type="button" id="mobile-menu-button" class="xl:hidden inline-flex items-center" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span data-menu-icon="open">{% include "icons/menu.svg" %}</span>
        <span data-menu-icon="close" class="hidden">{% include "icons/close.svg" %}</span>
      </button>
    </div>
  </div>

  {# Mobile menu: the links that are hidden below xl. `relative z-52` puts it above
     the promo banner (z-50) and the desktop Community popup (z-51), and below the
     Coveo suggestions (z-53, set in public/css/coveo.css). #}
  <div id="mobile-menu" class="hidden relative z-52 bg-brand-utility-blue-800 px-6 pb-6 text-page-text-contrast [&_a]:text-links-contrast">
    <ul class="flex flex-col gap-4 py-4">
      {% for item in primaryNav %}
      <li>{{ navLink(item.url | url, item.title, item.external, item.url == page.url) }}</li>
      {% endfor %}
      {% for item in utilityNav %}
      <li>{{ navLink(item.url, item.title, true, false) }}</li>
      {% endfor %}
      <li><a href="{{ forumUrl }}">Forum</a></li>
      <li class="md:hidden">
        <a class="inline-flex items-center gap-1 font-medium" href="{{ signUpUrl }}">
          Sign Up<span class="inline-flex items-center">{% include "icons/external-link.svg" %}</span>
        </a>
      </li>
    </ul>
    <ul class="flex gap-3" aria-label="Okta Developer social channels">
      {% for channel in socialChannels %}
      <li>
        <a href="{{ channel.url }}" class="block" aria-label="{{ channel.label }}">{% include "icons/" + channel.icon %}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</nav>

{% js %}
(function () {
  var button = document.getElementById("mobile-menu-button");
  var panel = document.getElementById("mobile-menu");
  if (!button || !panel) return;

  var openIcon = button.querySelector('[data-menu-icon="open"]');
  var closeIcon = button.querySelector('[data-menu-icon="close"]');
  var search = document.getElementById("nav-search");
  // Matches Tailwind's `xl`, the width at which the desktop nav takes over.
  var desktop = window.matchMedia("(min-width: 80rem)");

  function isOpen() {
    return button.getAttribute("aria-expanded") === "true";
  }

  function setOpen(open) {
    panel.classList.toggle("hidden", !open);
    if (search) search.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (openIcon) openIcon.classList.toggle("hidden", open);
    if (closeIcon) closeIcon.classList.toggle("hidden", !open);
  }

  function close(returnFocus) {
    if (!isOpen()) return;
    setOpen(false);
    if (returnFocus) button.focus();
  }

  // #nav-search is outside the panel, so without this focusing it closes the menu.
  function isOutside(target) {
    if (search && search.contains(target)) return false;
    return !panel.contains(target) && !button.contains(target);
  }

  button.addEventListener("click", function () {
    setOpen(!isOpen());
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") close(true);
  });

  // Pointer and keyboard both dismiss when attention moves out of the menu.
  document.addEventListener("click", function (event) {
    if (isOpen() && isOutside(event.target)) close(false);
  });
  document.addEventListener("focusin", function (event) {
    if (isOpen() && isOutside(event.target)) close(false);
  });

  // The desktop nav and an open panel must never both be on screen. Listen for
  // the breakpoint crossing and also check on resize, since a `change` event
  // isn't always delivered when the viewport is resized programmatically.
  function closeIfDesktop() {
    if (isOpen() && desktop.matches) close(false);
  }
  desktop.addEventListener("change", closeIfDesktop);
  window.addEventListener("resize", closeIfDesktop);
})();

(function () {
  var button = document.getElementById("community-menu-button");
  var panel = document.getElementById("community-menu");
  if (!button || !panel) return;

  var chevron = button.querySelector("[data-community-chevron]");

  function isOpen() {
    return button.getAttribute("aria-expanded") === "true";
  }

  function setOpen(open) {
    panel.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
    if (chevron) chevron.classList.toggle("rotate-180", open);
  }

  function isOutside(target) {
    return !panel.contains(target) && !button.contains(target);
  }

  button.addEventListener("click", function () {
    setOpen(!isOpen());
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      button.focus();
    }
  });

  document.addEventListener("click", function (event) {
    if (isOpen() && isOutside(event.target)) setOpen(false);
  });
  document.addEventListener("focusin", function (event) {
    if (isOpen() && isOutside(event.target)) setOpen(false);
  });
})();
{% endjs %}
