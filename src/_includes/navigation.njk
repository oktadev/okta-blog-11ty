<nav class="bg-okta-dark-blue">
  <div class="px-6 lg:px-16 min-h-16 xl:min-h-20 flex items-center gap-6 text-okta-white">

    <a class="shrink-0 mr-3 text-okta-white [&_svg]:w-40 [&_svg]:h-auto" href="https://developer.okta.com" aria-label="Okta Developer home">{% include "icons/logotype.svg" %}</a>

    {# Primary navigation — hidden below lg, moves into the mobile menu once it exists #}
    <div class="hidden lg:flex items-center gap-6">
      <label>
        <input type="search" placeholder="Search..." class="px-3 py-2 rounded-sm bg-okta-white/10 placeholder-okta-white/60 focus:outline-none focus:ring-2 focus:ring-okta-white/30" />
      </label>

      <div class="relative group">
        <button type="button" class="inline-flex items-center gap-1">
        Community
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div class="absolute right-0 top-8 hidden w-max rounded-sm bg-okta-white p-4 shadow-md group-hover:block group-focus-within:block z-51 before:absolute before:-top-2 before:left-0 before:right-0 before:h-2 before:content-['']">
          <div class="absolute -top-2 right-6 w-0 h-0 border-l-8 border-r-8 border-b-8 border-l-transparent border-r-transparent border-b-okta-white"></div>
          <a href="https://devforum.okta.com/" class="block text-okta-carbon">Forum</a>
          <hr class="my-2 border-t border-okta-carbon/50"/>
          <ul class="flex gap-3" aria-label="Okta Developer social channels">
            <li><a href="https://github.com/oktadev" class="block text-okta-carbon transition-transform hover:scale-110 focus-visible:scale-110" aria-label="Okta Developers on GitHub">{% include "icons/github.svg" %}</a></li>
            <li><a href="https://x.com/OktaDev" class="block text-okta-carbon transition-transform hover:scale-110 focus-visible:scale-110" aria-label="Okta Developers on X">{% include "icons/x.svg" %}</a></li>
            <li><a href="https://www.youtube.com/channel/UC5AMiWqFVFxF1q9Ya1FuZ_Q/featured" class="block text-okta-carbon transition-transform hover:scale-110 focus-visible:scale-110" aria-label="Okta Developers on YouTube">{% include "icons/youtube.svg" %}</a></li>
          </ul>
        </div>
      </div>

      {% set primaryNav = [
        { url: "/blog/", title: "Blog" },
        { url: "https://developer.okta.com/pricing/", title: "Pricing", external: true }
      ] %}
      <ul class="flex items-center gap-4">
        {% for item in primaryNav %}
        <li>
          <a class="inline-flex items-center gap-1 text-okta-white" href="{{ item.url | url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}{% if item.url == page.url %} aria-current="page"{% endif %}>
            {{ item.title }}{% if item.external %}<span class="inline-flex items-center opacity-70">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>{% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>

    {# Utility links — collapse into the mobile menu; the Sign Up CTA stays visible #}
    <div class="ml-auto flex shrink-0 items-center gap-4">
      {% set utilityNav = [
        { url: "https://help.okta.com/", title: "Okta Docs" },
        { url: "https://okta.com/", title: "Okta" },
        { url: "https://login.okta.com/", title: "Sign in to Okta" }
      ] %}
      <ul class="hidden items-center gap-4 lg:flex">
        {% for item in utilityNav %}
        <li>
          <a class="inline-flex items-center gap-1 text-okta-white" href="{{ item.url }}" target="_blank" rel="noopener">
            {{ item.title }}<span class="inline-flex items-center opacity-70">{% include "icons/external-link.svg" %}</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        {% endfor %}
      </ul>

      <a class="inline-flex shrink-0 items-center whitespace-nowrap rounded border border-okta-white px-6 py-2 font-medium text-okta-white" href="https://developer.okta.com/signup/">Sign Up</a>

      {# TODO: not wired up yet — needs a toggle and a panel holding the primary nav #}
      <button type="button" class="lg:hidden inline-flex items-center" aria-expanded="false" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>
