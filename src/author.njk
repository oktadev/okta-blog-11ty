---
layout: base
pagination:
  data: authors
  size: 1
  alias: author
  resolve: values
permalink: blog/authors/{{ author.full_name | slugify }}/
---

<div class="container m-w-128">
  {% if author.avatar%}
    {% avatar author.avatar, "large" %}
  {% endif %}
  <h2>{{ author.full_name }}</h2>
  {% if author.bio %}
    {{ author.bio }}
  {% endif %}
  <div>
    {% if author.github %}
      {{ author.github }}
    {% endif %}
    {% if author.web %}
      {{ author.web }}
    {% endif %}
    {% if author.linkedin %}
      {{ author.linkedin }}
    {% endif %}
    {% if author.email %}
      {{ author.email }}
    {% endif %}
    {% if author.twitter %}
      {{ author.twitter }}
    {% endif %}
  </div>
  <div>
    <p>All posts by {{ author.full_name }}</p>
    <hr>
    <ol reversed class="flex flex-col justify-center m-auto max-w-128">
      {% for post in collections.posts | postsAuthorFilter(author.full_name) %}
        {%- set authorsList = [author] %}
        <li class="grid gap-3 mb-5 pb-5 border-b-1 border-okta-gravel">
          <div class="grid gap-1">
            <a href="{{ post.url }}">
              <h2>{{ post.data.title if post.data.title else '<code>' + post.url + '</code>' }}</h2>
            </a>
            <div class="flex gap-1 items-center">
              {%- for authorItem in authorsList %}
                <a href="/authors/{{ authorItem.slug }}/" class="inline-flex items-center gap-1">
                  {% avatar authorItem.avatar %}
                  {{ authorItem.display_name }}
                </a>
                {% if not loop.last %} | {% endif %}
              {%- endfor %}
              |
              <time datetime="{{ post.date | htmlDateString }}">
                {{ post.date | readableDate }}
              </time>
              |
              {{ post.content | readingTime | safe }}
            </div>
          </div>
          {% if post.data.description %}
            <p>{{ post.data.description }}</p>
          {% endif %}
          <a href="{{ post.url }}">Read more</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</div>
