---
layout: base
pagination:
  data: authors
  size: 1
  alias: authorKey
permalink: blog/authors/{{ authorKey }}/
---

{% set author = authors[authorKey] %}
<div>
  <div class="flex items-center flex-wrap gap-4 mb-6">
    {% if author.avatar %}
      {% avatar author.avatar, "xlarge", author.full_name %}
    {% endif %}
    <h1 class="text-page-title text-4xl">{{ author.full_name }}</h1>
  </div>

  {% include "author-socials.njk" %}

  {% if author.bio %}
    <div class="mt-8 text-content-text">{{ author.bio | safe }}</div>
  {% endif %}
  <div class="mt-12">
    <h2 class="text-xl font-okta text-page-text">All posts by {{ author.full_name }}</h2>
    <hr class="my-8 border-page-border">
    <ol reversed class="flex flex-col">
      {% for post in collections.posts | postsAuthorFilter(authorKey) | reverse %}
        <li class="mb-5 pb-6 border-b border-page-border">
          <article class="grid gap-6">
            <div class="grid gap-3">
              {# Colour goes on the <a>: the base `a` rule would override it on the heading. #}
              <h3 class="font-okta text-2xl"><a class="text-brand-primary-blue-400" href="{{ post.url }}">{{ post.data.title if post.data.title else '<code>' + post.url + '</code>' }}</a></h3>
              {# Stacks one datapoint per row until sm, where it inlines and the separators appear. #}
              <div class="flex flex-col items-start gap-3 text-content-text sm:flex-row sm:flex-wrap sm:items-center">
                <time datetime="{{ post.date | htmlDateString }}">
                  {{ post.date | readableDate }}
                </time>
                <span aria-hidden="true" class="hidden text-pipe-delimiter sm:inline">|</span>
                {{ post.data.readingTime | readingTimeBadge | safe }}
              </div>
            </div>
            {% set excerpt = post | postExcerpt %}
            {% if excerpt %}
              <p class="text-content-text">{{ excerpt }}</p>
            {% endif %}
            <a class="text-lg" href="{{ post.url }}">Read more</a>
          </article>
        </li>
      {% endfor %}
    </ol>
  </div>
</div>
