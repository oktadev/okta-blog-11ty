---
layout: base
pagination:
  data: authors
  size: 1
  alias: authorKey
permalink: blog/authors/{{ authorKey }}/
---

{# Paginate over author keys so the URL uses the key (matches live, e.g.
   /blog/authors/akanksha-bhasin/); resolve the value object for the body. #}
{% set author = authors[authorKey] %}
<div class="container m-w-128">
  <div class="flex items-center gap-2.5">
    {% if author.avatar %}
      {% avatar author.avatar, "xlarge", author.full_name %}
    {% endif %}
    <h1 class="text-okta-cobalt text-4xl font-bold">{{ author.full_name }}</h1>
  </div>

  {% include "author-socials.njk" %}

  {% if author.bio %}
    <div class="mt-8">{{ author.bio | safe }}</div>
  {% endif %}
  <div>
    <p>All Posts by {{ author.full_name }}</p>
    <hr>
    <ol reversed class="flex flex-col justify-center m-auto max-w-128">
      {% for post in collections.posts | postsAuthorFilter(authorKey) | reverse %}
        <li class="grid gap-3 mb-5 pb-5 border-b-1 border-okta-gravel">
          <div class="grid gap-1">
            <a href="{{ post.url }}">
              <h2>{{ post.data.title if post.data.title else '<code>' + post.url + '</code>' }}</h2>
            </a>
            <div class="flex gap-1 items-center">
              <time datetime="{{ post.date | htmlDateString }}">
                {{ post.date | readableDate }}
              </time>
              |
              {{ post.data.readingTime | readingTimeBadge | safe }}
            </div>
          </div>
          {% if post.data.description %}
            <p>{{ post.data.description }}</p>
          {% endif %}
          <a href="{{ post.url }}">Read more</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</div>
