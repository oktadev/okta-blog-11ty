---
layout: base
pagination:
  data: collections.communities
  size: 1
  alias: community
permalink: blog/communities/{{ community.slug }}/
---

<div>
  <h1 class="text-page-title text-4xl my-6">{{ community.label }} posts</h1>
  <hr class="my-8 border-page-border">

  <ol reversed class="flex flex-col">
    {% for post in community.posts | reverse %}
      {%- set authorsList = authors | authorFilter(post.data.author) %}
      <li class="mb-5 pb-6 border-b border-page-border">
        <article class="grid gap-6">
          <div class="grid gap-3">
            {# Colour goes on the <a>: the base `a` rule would override it on the heading. #}
            <h2 class="font-okta text-2xl"><a class="text-brand-primary-blue-400" href="{{ post.url }}">{{ post.data.title if post.data.title else '<code>' + post.url + '</code>' }}</a></h2>
            {# Stacks one datapoint per row until sm, where it inlines and the separators appear. #}
            <div class="flex flex-col items-start gap-3 text-content-text sm:flex-row sm:flex-wrap sm:items-center">
              {%- for author in authorsList %}
                <a href="/blog/authors/{{ author.slug }}/" class="inline-flex items-center gap-2">
                  {% avatar author.avatar, "small", author.display_name %}
                  {{ author.display_name }}
                </a>
                {% if not loop.last %}<span aria-hidden="true" class="hidden text-pipe-delimiter sm:inline">|</span>{% endif %}
              {%- endfor %}
              <span aria-hidden="true" class="hidden text-pipe-delimiter sm:inline">|</span>
              <time datetime="{{ post.date | htmlDateString }}">
                {{ post.date | readableDate }}
              </time>
              <span aria-hidden="true" class="hidden text-pipe-delimiter sm:inline">|</span>
              {{ post.data.readingTime | readingTimeBadge | safe }}
            </div>
          </div>
          {% set excerpt = post | postExcerpt %}
          {% if excerpt %}
            <p class="text-content-text">{{ excerpt }}</p>
          {% endif %}
          <a class="text-lg" href="{{ post.url }}">Read more</a>
        </article>
      </li>
    {% endfor %}
  </ol>
</div>
