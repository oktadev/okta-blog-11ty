---
layout: base
permalink: /blog/tags/
---

<div class="grid gap-4">
  <h1 class="text-okta-cobalt text-4xl my-6">Tags</h1>

  <div class="grid gap-1 max-w-md">
    <label for="tag-search" class="text-xl">Filter tags</label>
    <div class="relative">
      <input
        type="search"
        id="tag-search"
        placeholder="Try oidc, python, or express"
        autocomplete="off"
        class="border border-okta-gravel rounded pl-3 pr-9 py-2 w-full"
      />
      <button
        type="button"
        id="tag-clear"
        aria-label="Clear filter"
        style="display: none"
        class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center cursor-pointer text-okta-slate hover:text-okta-carbon"
      >
        {% include "icons/close.svg" %}
      </button>
    </div>
  </div>

  <p id="tag-status" role="status" aria-live="polite" aria-atomic="true" class="text-okta-slate min-h-6"></p>

  <div id="tag-groups" class="grid gap-9">
    {% for group in collections | tagsByLetter %}
      <section class="tag-group grid gap-6" data-letter="{{ group.letter }}">
        <h2 class="text-okta-cobalt font-okta text-2xl border-b border-okta-gravel pb-1">{{ group.letter }}</h2>
        <div class="flex flex-wrap gap-3">
          {% for tag in group.tags %}
            <a
              href="/blog/tags/{{ tag | slugify }}/"
              class="tag-link inline-flex items-center h-6 px-2 rounded bg-okta-cloud-tint text-okta-blue whitespace-nowrap"
            >{{ tag }}</a>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</div>

<script>
  (function () {
    var input = document.getElementById("tag-search");
    if (!input) return;
    var groups = Array.prototype.slice.call(
      document.querySelectorAll(".tag-group")
    );
    var status = document.getElementById("tag-status");
    var clearBtn = document.getElementById("tag-clear");

    function filter() {
      var q = input.value.trim().toLowerCase();
      var matchCount = 0;
      groups.forEach(function (group) {
        var anyTagVisible = false;
        group.querySelectorAll(".tag-link").forEach(function (link) {
          var match = link.textContent.toLowerCase().indexOf(q) !== -1;
          // Inline style beats the inline-flex/grid display utility classes.
          link.style.display = match ? "" : "none";
          if (match) {
            anyTagVisible = true;
            matchCount++;
          }
        });
        group.style.display = anyTagVisible ? "" : "none";
      });

      // Toggle the clear button via style (the hidden attr would lose to inline-flex).
      if (clearBtn) clearBtn.style.display = q === "" ? "none" : "inline-flex";

      if (status) {
        status.textContent =
          q === ""
            ? ""
            : matchCount + (matchCount === 1 ? " Result" : " Results");
      }
    }

    input.addEventListener("input", filter);

    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        input.value = "";
        filter();
        input.focus();
      });
    }
  })();
</script>
