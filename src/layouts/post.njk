---
layout: base
---
{% css %}{% include "node_modules/prismjs/themes/prism-okaidia.css" %}{% endcss %}

<article class="flex flex-col max-w-[1000] m-auto gap-3">
    <h1 class="text-4xl font-medium text-okta-cobalt">{{ title }}</h1>
    {% if image %}
      {% img {src: image, alt: "", header: true} %}
    {% endif %}
    <div class="prose prose-lg max-w-none">
      {% if description %}
        <p class="description">{{ description }}</p>
      {% endif %}
      {{ content | safe }}
    </div>
</article>
