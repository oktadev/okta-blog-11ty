---
layout: base
---
{% css %}{% include "node_modules/prismjs/themes/prism-okaidia.css" %}{% endcss %}

<article class="flex flex-col max-w-[1000] m-auto">
    <h1>{{ title }}</h1>
    {% if image %}
      {% img image, "" %}
    {% endif %}
    <div>
      {% if description %}
        <p class="description">{{ description }}</p>
      {% endif %}
      {{ content | safe }}
    </div>
</article>
