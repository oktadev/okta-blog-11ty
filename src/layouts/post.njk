---
layout: base
---
{% css %}{% include "public/css/prism-okta.css" %}{% endcss %}

{% set changelogList = changelog | changelogEntries %}
{# gap, not space-y: v4 wraps space-* in :where(), so any child margin silently wins. #}
<article class="flex flex-col gap-6">
    {% set postTags = tags | visibleTags %}
    {% if postTags | length %}
      <ul class="tags flex flex-wrap gap-x-3 gap-y-2 mt-4">
        {%- for tag in postTags | sort -%}
          <li class="flex items-center h-6 px-2 rounded bg-okta-cloud-tint whitespace-nowrap">
            <a href="/blog/tags/{{ tag | slugify }}/" class="text-okta-blue">{{ tag }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {% endif %}
    <h1 class="text-5xl leading-tight text-okta-dark-blue font-light">{{ title }}</h1>
    {% set postAuthors = authors | authorFilter(author) %}
    {# Stacks one datapoint per row until sm, where it inlines and the separators appear. #}
    <div class="post-byline flex flex-col items-start gap-3 text-base text-content-text sm:flex-row sm:flex-wrap sm:items-center">
      {% if postAuthors | length %}
        <span class="authors flex flex-wrap items-center gap-3">
          {%- for a in postAuthors -%}
            <a href="/blog/authors/{{ a.slug }}/" class="inline-flex items-center gap-2 text-okta-blue">
              {% avatar a.avatar, "small", a.display_name %}
              {{ a.display_name }}
            </a>
          {%- endfor -%}
        </span>
        <span aria-hidden="true" class="hidden text-okta-slate sm:inline">|</span>
      {% endif %}
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true" class="hidden text-okta-slate sm:inline">|</span>
      {% if changelogList | length %}
      <div class="last-updated text-content-text">
        Last Updated:&nbsp;<a href="#changelog">{{ changelogList[0].date | readableDate("LLLL d, yyyy") }}</a>
      </div>
      {% endif %}
      <span aria-hidden="true" class="hidden text-okta-slate sm:inline">|</span>

      {{ readingTime | readingTimeBadge | safe }}
      <span aria-hidden="true" class="hidden text-okta-slate sm:inline">|</span>
      <span class="flex items-center gap-2 [&_svg]:size-4.5">
        <a href="https://twitter.com/intent/tweet?url={{ (page.url | toAbsoluteUrl) | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">{% include "icons/x.svg" %}</a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ (page.url | toAbsoluteUrl) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">{% include "icons/linkedin.svg" %}</a>
      </span>
    </div>
    {% set canonicalUrl = canonical | httpUrl %}
    {% if canonicalUrl %}
      <div class="canonical-note text-content-text">
        Originally published at <a href="{{ canonicalUrl }}" class="text-okta-blue" target="_blank" rel="noopener noreferrer">{{ canonicalUrl | hostname }}</a>.
      </div>
    {% endif %}

    {% if image %}
      {# Decorative: the <h1> above repeats the title, so alt="" keeps it out of the a11y tree. #}
      {% img {src: image, alt: "", header: true} %}
    {% endif %}
    <div class="blog-prose">
      {{ content | safe }}

      {% if changelogList | length %}
        <p id="changelog"><span class="font-semibold">Changelog</span>:</p>
        <ul class="changelog list-disc pl-5">
          {%- for entry in changelogList %}
            <li>{{ entry.date | readableDate("LLL d, yyyy") }}: {{ entry.text | inlineMarkdown | safe }}</li>
          {%- endfor %}
        </ul>
      {% endif %}
    </div>

    {% set postAuthors = authors | authorFilter(author) %}
    {% for author in postAuthors %}
      {% if author.full_name %}
        <div class="author-bio border-t border-okta-gravel pt-6 {{ 'mt-5' if loop.first }}">
          <div class="flex items-center gap-3 flex-wrap">
            {% if author.avatar %}
              <a href="/blog/authors/{{ author.slug }}/" class="shrink-0">{% avatar author.avatar, "small", author.full_name %}</a>
            {% endif %}
            <span class="author-name"><a href="/blog/authors/{{ author.slug }}/" class="text-okta-blue text-base">{{ author.full_name }}</a></span>
            {# The socials root carries mt-4 for the author page, where it stacks; here it sits inline. #}
            <span class="[&>div]:mt-0">{% include "author-socials.njk" %}</span>
          </div>
          {% if author.bio %}
            <div class="text-content-text text-base leading-relaxed mt-3">{{ author.bio | safe }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% set prevPost = collections.posts | getPreviousCollectionItem %}
    {% set nextPost = collections.posts | getNextCollectionItem %}
    <nav class="prev-next flex justify-between border-t border-okta-gravel pt-6 text-base">
      {% if prevPost %}
        <a href="{{ prevPost.url }}" class="text-okta-blue" title="{{ prevPost.data.title }}"><span class="inline-flex items-center align-middle rotate-180">{% include "icons/arrow-right.svg" %}</span>&nbsp;Previous post</a>
      {% else %}<span></span>{% endif %}
      {% if nextPost %}
        <a href="{{ nextPost.url }}" class="text-okta-blue" title="{{ nextPost.data.title }}">Next post&nbsp;<span class="inline-flex items-center align-middle">{% include "icons/arrow-right.svg" %}</span></a>
      {% endif %}
    </nav>

    {% include "comments.njk" %}
</article>
